# ───────────────────────────────────────────────
# Dhopa Mama — Environment Variables (উদাহরণ)
# এই ফাইল কপি করে ".env" বানান এবং আসল ভ্যালু বসান।
# ⚠️  .env কখনো git/zip এ শেয়ার করবেন না (.gitignore এ আছে)।
# ───────────────────────────────────────────────

# MongoDB Atlas connection string (নতুন পাসওয়ার্ড দিন)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/dhopamama?retryWrites=true&w=majority

# JWT signing secret — কমপক্ষে ৩২ অক্ষর, র‍্যান্ডম।
# তৈরি করুন: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login
ADMIN_USERNAME=
# পাসওয়ার্ড bcrypt হ্যাশ আকারে দিন (প্লেইন টেক্সট নয়):
#   npm run hash-password -- 'আপনার-শক্তিশালী-পাসওয়ার্ড'
ADMIN_PASSWORD_HASH=
# (পুরনো পদ্ধতি — শুধু ফলব্যাক, ব্যবহার না করাই ভালো)
# ADMIN_PASSWORD=

# টোকেনের মেয়াদ
ADMIN_TOKEN_TTL=8h
USER_TOKEN_TTL=7d

# CORS — কমা দিয়ে আলাদা করা অনুমোদিত origin (শেষে / দেবেন না)
ALLOWED_ORIGINS=https://dhopamama.com,https://www.dhopamama.com

PORT=8080

# Cloudinary (নতুন API key/secret রোটেট করে বসান)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Apps Script webhook (নতুন deployment URL)
APPS_SCRIPT_URL=
NOTIFY_EMAIL=
